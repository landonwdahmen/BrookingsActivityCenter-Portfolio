# Public placeholders for an isolated local demo; never use real credentials/data.
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_DB=bac_demo
POSTGRES_USER=bac_demo
POSTGRES_PASSWORD=local-demo-only
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=demo@example.com
PGADMIN_DEFAULT_PASSWORD=local-pgadmin-only

# Required: replace this placeholder with random output from:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Local HTTP: false. HTTPS: true (required when NODE_ENV=production).
SESSION_COOKIE_SECURE=false
# Only enable behind one trusted reverse proxy; do not expose Node directly then.
TRUST_PROXY=false
# Explicit one-time conversion for an existing academic/demo database only.
# Leave false normally; see docs/AUTHENTICATION.md before enabling.
MIGRATE_LEGACY_PASSWORDS=false
